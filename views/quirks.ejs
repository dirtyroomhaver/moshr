    <script>
      const createThreadForm = document.getElementById('modal-form')
      const buttonThreadForm = document.getElementById('button-thread')
      const textarea = document.getElementById('thread-text')
      createThreadForm.addEventListener('submit', async event => {
        // Prevent the browser from reloading the page
        event.preventDefault()
        const text = textarea.value
        const moshpit = document.querySelector('input[name="moshpit"]').value
        if (!text.trim()) {
          return
        }

        const response = await fetch('/api/create/thread', {
          method: 'POST',

          headers: {
            'Content-Type': 'application/json'
          },

          body: JSON.stringify({
            text: text,
            moshpit: moshpit
          })
        })

        if (!response.ok) {
          console.error('Failed to create thread')
          return
        }

        const data = await response.json()
        window.location.href = `/${data.moshpit.title}/${data.threadId}`
      })

  const createThread = document.getElementById('create-thread')
      const modal = document.getElementById('create-thread-box')
      //modal.showModal();

      createThread.addEventListener('click', () => {
        event.preventDefault()
        modal.showModal()
      })

      const closeButton = document.getElementById('close-button')

      closeButton.addEventListener('click', () => {
        event.preventDefault()

        modal.close()
      })
    


