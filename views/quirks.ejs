      </div>
      <div class="body-right">
        <div class="moshpit-info">
          <div class="tab-nav-div">
            <ul class="tab-nav">
              <li><B>trending</B></li>
            </ul>
          </div>
          <div>
            <ul class="info-list">
              <% trending.forEach(moshpit => { %>
              <li><a href="/<%= moshpit.title %>/">/<%= moshpit.title %>/ - <%= moshpit.post_count%> <%= moshpit.post_count === 1 ? 'post in the last hour' : 'posts in the last hour' %></a></li>
              <% }) %>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <dialog id="create-thread-box">
      <div class="modal-top">
        <div><p>new thread</p></div>
        <div><button id="close-button">x</button></div>
      </div>
      <form id="modal-form">
        <hr />
        <div>
          <div class="modal-input">
            <label for="">comment</label
            ><textarea
              name="text"
              id="thread-text"
              style="height: 400px; width: 96.4%"
            ></textarea>
          </div>

          <div class="modal-input">
            <label for="">moshpit (board)</label
            ><input
              type="text"
              name="moshpit"
              placeholder="if left blank your thread will go onto the homepage"
            />
          </div>

          <div class="modal-input">
            <label for="">signature</label
            ><input
              type="text"
              placeholder="put a secure password here to sign your post"
            />
          </div>
          <div><button type="submit" id="button-thread">submit</button></div>
          <input type="hidden" name="post-text" id="post-text" />
        </div>
      </form>
    </dialog>
    <!-- <form id="thread-form">
      <textarea
        id="thread-text"
        name="text"
        placeholder="Write a thread..."
      ></textarea>

      <button type="submit">Post</button>
    </form> -->

    <script>
      
  const createThread = document.getElementById('create-thread')
      const modal = document.getElementById('create-thread-box')
      //modal.showModal();

      createThread.addEventListener('click', () => {
        event.preventDefault()
        modal.showModal()
      })

      const closeButton = document.getElementById('close-button')

      closeButton.addEventListener('click', () => {
        event.preventDefault()

        modal.close()
      })
    


     
    </script>
  </body>
