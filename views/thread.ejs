<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= moshpit.title %> | <%= thread.comment %></title>
  <link rel="stylesheet" href="/../stylesheet.css" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <meta name="robots" content="noindex, follow" />
  <link rel="preload" href="../Mona.woff2" as="font" type="font/woff2" crossorigin>
  <script src="
https://cdn.jsdelivr.net/npm/dayjs@1.11.23/dayjs.min.js
"></script>
  <script src="https://cdn.jsdelivr.net/npm/dayjs@1/plugin/relativeTime.js"></script>
</head>

<body>


  <div class="navbar" id="navbar">
    <div class="navbar-left">
      <ul class="nav-list">
        <li><a href="/">home</a></li>
        <li>|</li>
        <li><a href="/rules">rules</a></li>
        <li>|</li>
        <li><a href="/faq">faq</a></li>
        <li>|</li>
        <li><a href="/quirks">quirks</a></li>
        <li>|</li>
        <li><a href="/moshpits">moshpits</a></li><p>|</p>
          <li><a href="/othersites">other sites</a></li>
      </ul>
    </div>
    <div class="navbar-middle">
      <div class="title">
        <h2 onclick="window.location.href='/<%= thread.moshpit %>/'">
          [ <%= thread.moshpit %> ]
        </h2>
      </div>
    </div>
    <div class="navbar-right">
      <a href="" id="create-thread">create new thread</a>
    </div>
  </div>

  <div class="navbar" id="navbar2">
    <div class="navbar-left">
      <select name="pages" id="pages" onchange="
    if (this.value.startsWith('/')) {
      window.location = this.value
    }
  ">

        <option value="" selected disabled hidden>pages</option>
        <option value="/">home</option>
        <option value="/rules">rules</option>
        <option value="/faq">faq</option>
        <option value="/quirks">quirks</option>
        <option value="/popular">popular</option>
            <option value="/trending">trending</option>
            <option value="/recent">recent</option>
            <option value="/othersites">other sites</option>

      </select>
    </div>
    <div class="navbar-middle">
      <div class="title">
        <h2 onclick="window.location.href='/<%= thread.moshpit %>/'">
          [ <%= thread.moshpit %> ]
        </h2>
      </div>
    </div>
    <div class="navbar-right">
      <button id="create-thread2">New +</button>
    </div>
  </div>

  <% if (settings.announcement_status) {  %>
  <div class="announcement">
    <p id="announcement-text"><%- settings.announcement %></p>
  </div> <% } %>

  <div class="body" id="fakebody">
    <div class="body-right1">
      <div class="moshpit-info">
        <div class="tab-nav-div">
          <ul class="tab-nav">
            <li><B>recently created</B></li>
          </ul>
        </div>
        <div>
          <ul class="info-list">
            <% recent.forEach(moshpit => { if (!moshpit.hid) { %>
            <li><a href="/<%= moshpit.title %>/">/<%= moshpit.title %>/ - <%= moshpit.post_count + moshpit.thread_count%> <%= moshpit.post_count+ moshpit.thread_count === 1 ? 'post' : 'posts' %></a></li>
            <% }}) %>
          </ul>
        </div>
      </div>
    </div>
    <div class="body-left">
      <div class="body-thread">
        <div class="thread-options" id="header">
          <div class="options-div">
            <a href="/all/0">all&nbsp</a>|
            <a href="/<%= thread.moshpit %>/">return&nbsp</a>|
            <a href="" class="update">update&nbsp</a>|
            <a href="#footer">bottom&nbsp</a>|
            <a href="" class="reply-button" data-thread-id="">reply</a>
          </div>
        </div>

        <div id="post-container">
          <div class="post" id="OP">
            <div class="post-header" data-headerid="OP">
              <div style="display: flex; justify-content: space-between; align-items: center">
                <div style="display: flex">
                  <% if(posts) { %>
                  <p>OP |&nbsp</p>
                  <% } %> <% if(thread.is_owner) { %>
                  <p style="color: var(--rage)">vak&nbsp</p>|&nbsp
                  <% } %>
                  <p><% if (moshpit.flags){ %> <%=  thread.country %> |&nbsp<%}%></p>
                <p itemprop="" class="timer" title="<%= new Date(thread.created_at * 1000).toLocaleString('en-US', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric',
                      hour: 'numeric',
                      minute: '2-digit'
                    }) %>" data-time=<%- thread.created_at %>></p>
                </div>
                <div style="display: flex; align-items: center" class="postheaderoptions">
                  <% if (thread.author_id != user.id && ( user.is_owner || user.is_admin)) { %>
                  <a href="" class="info" data-authorid="<%- thread.author_id %>">info</a>&nbsp|&nbsp
                  <% } %>
                  <% if (thread.author_id != user.id && (user.is_owner || user.is_admin || user.is_mod)) { %>
                  <a href="" class="ban" data-postid="<%- thread.id %>" data-type="OP" data-threadid="OP">ban</a>&nbsp|&nbsp
                  <% } %>
                  <% if ((user.is_owner || user.is_admin || user.is_mod || user.is_janitor)) { %>
                  <a href="" class="delete" data-postid="<%- thread.id %>" data-type="OP" data-threadid="OP">delete</a>&nbsp|&nbsp
                  <% } %>
                  <% if (( user.is_owner || user.is_admin || user.is_mod || user.is_janitor)) { %>
                  <a href="" class="hide" data-postid="<%- thread.id %>" data-type="OP">hide</a>&nbsp|&nbsp
                  <% } %>
                  <a href="" class="reply-button" data-thread-id="OP">reply</a>&nbsp|&nbsp
                  <a href="" class="report_a" data-thread-id="OP" data-id="<%- thread.id %>">report</a>
       
                </div>
              </div>
            </div>
            <div class="backpanel" data-postid="OP">
              <div class="post-body"><p><%- thread.html  %></p></div>
                <div class="bombaclot">
               <% if (thread.sig || thread.slapped || thread.shot) { %>
               
                <hr class="" style="margin-bottom: 3px; margin-top: 3px; border-color: 1px solid var(--border-color); color: var(--border-color); background-color: var(--border-color)"> 
                  
               
                <% } %>
                   </div>
              <div data-alarm="OP" class="hidden" style="color: var(--rage); font-weight: bold; margin-top: 3px;">
              
              </div>
              <div class="clot">
                <% if (thread.sig) { %>
                <p class="signature" title="<%- thread.sig %>">signature: <%- thread.sig %></p>
                
              <% } %>
                </div>
            </div>
            <div class="replylist hidden">
              <ul class="post-replies"></ul>
            </div>
          </div>


          <% if (posts) {
          posts.forEach(post => { %>
          <div class="post" id="<%= post.post_number %>">
            <div class="post-header" data-headerid="<%= post.post_number %>">
              <div style="display: flex; justify-content: space-between; align-items: center">
                <div style="display: flex">
                  <p><%= post.post_number %> |&nbsp</p>
                  <% if (post.is_owner) { %>
                  <p style="color: var(--rage)">vak&nbsp</p>|&nbsp
                  <% } %>
                  <p><% if (moshpit.flags){ %> <%=  post.country %> |&nbsp<%}%> </p>
                    <p itemprop="" class="timer" title="<%= new Date(thread.created_at * 1000).toLocaleString('en-US', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric',
                      hour: 'numeric',
                      minute: '2-digit'
                    }) %>" data-time="<%= post.created_at %>"></p>
                </div>
                <div style="display: flex; align-items: center" class="postheaderoptions">
                  <% if (post.author_id != user.id && ( user.is_owner || user.is_admin)) { %>
                  <a href="" class="info" data-authorid="<%= post.author_id %>">info</a>&nbsp|&nbsp
                  <% } %>
                  <% if (post.author_id != user.id && (user.is_owner || user.is_admin || user.is_mod)) { %>
                  <a href="" class="ban" data-postid="<%= post.id %>" data-type="post" data-threadid="<%- post.number %>">ban</a>&nbsp|&nbsp
                  <% } %>
                  <% if ((user.is_owner || user.is_admin || user.is_mod || user.is_janitor)) { %>
                  <a href="" class="delete" data-postid="<%= post.id %>" data-type="post" data-threadid="<%- post.number %>">delete</a>&nbsp|&nbsp
                  <% } %>
                  <% if ((user.id == thread.author_id || user.is_owner || user.is_admin || user.is_mod || user.is_janitor)) { %>
                  <a href="" class="hide" data-postid="<%= post.id %>" data-type="post">hide</a>&nbsp|&nbsp
                  <% } %>
                  <% if (post.author_id != user.id && (user.id == thread.author_id || user.is_owner || user.is_admin)) { %>
                  <a href="" class="shoot" data-postid="<%= post.id %>">shoot</a>&nbsp|&nbsp
                  <% } %>
                  <% if (post.author_id != user.id && (user.id == thread.author_id || user.is_owner || user.is_admin || user.is_mod || user.is_janitor)) { %>
                  <a href="" class="slap" data-postid="<%= post.id %>">slap</a>&nbsp|&nbsp
                  <% } %>
                  <a href="" class="reply-button" data-thread-id="<%= post.post_number %>">reply</a>&nbsp|&nbsp
                  <a href="" class="report_a" data-thread-id="<%= post.post_number %>" data-id="<%- post.id %>">report</a>
                </div>
              </div>
            </div>


            <div class="backpanel <% if ((post.hid === 1)) { %> hidden <% } %>" data-postid="<%= post.id %>">
              <div class="post-body"><p><%- post.html %></p></div>
               <div class="bombaclot">
               <% if (post.sig || post.slapped || post.shot) { %>
               
                <hr class="" style="margin-bottom: 3px; margin-top: 3px; border-color: 1px solid var(--border-color); color: var(--border-color); background-color: var(--border-color)"> 
                  
               
                <% } %>
                   </div>
              <div data-alarm="<%= post.id %>" class="<% if ((post.slapped === 0 && post.shot ===0)) { %> hidden <% } %>" style="color: var(--rage); font-weight: bold; margin-top: 3px; margin-bottom: 3px">
                <% if (post.shot) { %>USER WAS SHOT FOR THIS POST
                <% } else if (post.slapped) { %>
                USER WAS SLAPPED FOR THIS POST <% } %>
              
              </div>
              <div class="clot">
                <% if (post.sig) { %>
                <p class="signature" title="<%- post.sig %>">signature: <%- post.sig %></p>
                
              <% } %>
                </div>


            </div>

              <div class="hidden replylist">
                <ul class="post-replies">

                </ul>
              </div>
          </div>
          <% })} %>
        </div>


        <div class="thread-options" id="footer">
          <div class="options-div">
            <a href="/all/0">all&nbsp</a>|
            <a href="/<%= thread.moshpit %>/">return&nbsp</a>|
            <a href="" class="update">update&nbsp</a>|
            <a href="#navbar">top&nbsp</a>|
            <a href="" class="reply-button" data-thread-id="">reply</a>
          </div>
        </div>
        <div class="anchor"></div>
      </div>
    </div>
    <div class="body-right">
      <div class="moshpit-info">
        <div class="tab-nav-div">
          <ul class="tab-nav">
            <li><B>trending</B></li>
          </ul>
        </div>
        <div>
          <ul class="info-list">
            <% trending.forEach(moshpit => { if (!moshpit.hid) { %>
            <li><a href="/<%= moshpit.title %>/">/<%= moshpit.title %>/ - <%= moshpit.recent_count %> <%= moshpit.recent_count === 1 ? 'recent post' : 'recent posts' %></a></li>
            <% }}) %>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <dialog id="create-thread-box">
    <div class="modal-top">
      <div>
        <p>new thread</p>
      </div>
      <div><button id="close-button">x</button></div>
    </div>
    <form id="modal-form">
      <hr />
      <div>
        <div class="modal-input">
          <label for="">comment</label><textarea name="text" id="thread-text" style="height: 400px; width: 96.4%"></textarea>
        </div>

        <div class="modal-input">
          <label for="">moshpit (board)</label><input type="text" name="moshpit" value="<%= thread.moshpit %>" placeholder="if left blank your thread will go onto /moshpit/ <= 7 chars" />
        </div>

        <div class="modal-input">
          <label for="">signature</label><input type="text" name="sig" placeholder="put a secure password here to sign your post" />
        </div>
        <div><button type="submit" id="button-thread">submit</button></div>
        <input type="hidden" name="post-text" id="post-text" />
      </div>
    </form>
  </dialog>

  <dialog id="report-box">
    <div class="modal-top">
      <div>
        <p>report</p>
      </div>
      <div><button id="close-button-2">x</button></div>
    </div>
    <hr />
    <form id="modal-form-report">
      <div>
        <label for="rule-select">which rule was violated?</label>
        <select name="reported_rule" id="rule-select">
          <option value="" selected disabled hidden>
            --please choose a rule--
          </option>
          <option value="1">
            1. dont post anything that violates local or US law
          </option>
          <option value="2">2. dont do or advocate for in site or out of site raids</option>
          <option value="3">3. dont spam, use zalgo text, abuse ascii art, or abuse whitespace </option>
          <option value="4">
            4. dont advertise anything you get monetary gain from
          </option>
          <option value="5">5. dont post offtopic threads or replies</option>
          <option value="6">6. dont dox</option>
          <option value="7">7. dont send false reports</option>
          <option value="8">8. dont evade bans</option>
          <option value="9">9. dont advocate for pedophilia or zoophilia</option>
          <option value="10">
            10. dont link to or request nsfw or harmful (malware for example) content
          </option>
        </select>
        <label>false reports = ban</label>
        <button type="submit">submit</button>
      </div>
    </form>
  </dialog>

  <div id="myPopup" class="popup hidden">
    <div id="myPopupHeader" class="popup-header">
      <p>reply</p>
      <button id="close-button3">x</button>
    </div>
    <div style="background-color: var(--panel); padding: 3px">
      <form action="" id="reply-form">
        <textarea name="reply" id="reply-textarea"></textarea>
        <div>
          <div>
            <label for="reply-sig" style="margin: 0px 0px 0px -5px">signature</label>
            <input id="reply-sig" name="sig" type="text" placeholder="put a secure password here to sign your post" style="width: 100%" />
          </div>
          <input type="hidden" name="post-text1" id="post-text1" />

          <div style="display: flex; justify-content: right; margin-top: 5px">
            <button id="submit-reply" type="submit">submit</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script defer>
    if (window.dayjs_plugin_relativeTime) {
    dayjs.extend(window.dayjs_plugin_relativeTime)
}
    let timers = document.querySelectorAll('.timer')
    timers.forEach((t) => {
      t.textContent = dayjs.unix(Number(t.dataset.time)).fromNow()
    })
    let timerid;

    function timerup() {
      if (!timerid)[
        timerid = setInterval(() => {
          timers = document.querySelectorAll('.timer')

          timers.forEach((t) => {

            t.textContent = dayjs.unix(Number(t.dataset.time)).fromNow()
          })
        }, 1000)
      ]
    }
    timerup()


    function updateReplyLinks() {
      document.querySelectorAll('.replylist').forEach(el => {
    el.classList.add('hidden');
});
    
    document.querySelectorAll('.post-replies').forEach(el => {
        el.replaceChildren()
    });
    
    const replies = new Map()

    document.querySelectorAll('.post').forEach(post => {
        const replierId = post.id

        const quotedPosts = new Set()

        post.querySelectorAll('.post-body .quote').forEach(quote => {
            const quotedId = quote.dataset.quoteid.trim();
          
            quotedPosts.add(quotedId)
            
        });
        
        for (const quotedId of quotedPosts) {
            if (!replies.has(quotedId)) {
                replies.set(quotedId, [])
            }

            replies.get(quotedId).push(replierId)
        }
    });
    

    for (const [quotedId, replierIds] of replies) {
        const targetPost = document.getElementById(quotedId)
        if (!targetPost) continue

        const container = targetPost.querySelector('.post-replies');
        targetPost.querySelector('.replylist').classList.remove('hidden')
        for (const replierId of replierIds) {
          if (replierId == quotedId) continue
            const li = document.createElement('li');
            const link = document.createElement('a')
            link.classList.add('quote')
            link.dataset.quoteid = replierId
            link.style.color = 'var(--rage)'
            link.href = `#${replierId}`;
            link.innerHTML = `@${replierId}&nbsp`;
            li.appendChild(link)
            container.appendChild(li);
        }
    }
}
updateReplyLinks()
    const updaters = document.querySelectorAll('.update')

    updaters.forEach(u => {
      u.addEventListener('click', async event => {
        event.preventDefault()
        location.reload()
      })
    })

    function quote(post_id) {

    }
    const quotes = document.querySelectorAll('.quote')
    window.addEventListener("scroll", () => {
      let tochange = document.querySelectorAll('.backpanel')
      tochange.forEach(panel => {
        panel.style.backgroundColor = 'var(--panel)'
      })
      document.querySelectorAll('.post-header').forEach(header => {
        header.style.backgroundImage = 'linear-gradient(var(--panel), var(--gradient))'
      })
      let todelete = document.querySelectorAll('.hoverquote')

      todelete.forEach(hover => {
        if (hover) {
          hover.remove()

        }

      })



    }, {
      passive: true
    });

    document.addEventListener('pointerover', (e) => {
      const quote = e.target.closest(".quote")
      if (!quote) return;
      console.log('pointer1')
      if (e.pointerType !== "mouse") return;
      

      const quoteid = quote.dataset.quoteid;

      let quoted

      if (Number(quoteid) == quoteid) {
        quoted = document.getElementById(Number(quoteid))
      } else {
        quoted = document.getElementById('OP')

      }
      if (isVisible(quoted)) {
        quoted.querySelector(".backpanel").style.backgroundColor = 'var(--gradient)'
        if ( quoted.querySelector(".backpanel").classList.contains('hidden')) {
        quoted.querySelector(".post-header").style.backgroundImage = 'linear-gradient(var(--gradient), var(--ee))'

        }
      } else {


        let quotepost = quoted.cloneNode(true)
        quotepost.style.position = 'fixed'
        
        quotepost.style.left = '50%'
        quotepost.style.top = '50%'
        quotepost.style.transform = 'translate(-50%, -50%)'
        quotepost.classList.add('hoverquote')
        quotepost.style.minWidth = '400px'
        quotepost.style.maxHeight = '100vh'
        quotepost.style.overflow = 'hidden'
        quotepost.style.width = '69%'
        quotepost.style.border = '1px solid var(--rage)'
        quotepost.dataset.oldid = quoteid
        quotepost.querySelector(".backpanel").classList.remove('hidden')
        quotepost.id = quoteid + 'hover'
        const body = document.getElementById('fakebody')
        body.appendChild(quotepost)
      }
    })




    document.addEventListener('pointerout', e => {
      const quote = e.target.closest(".quote")

      if (!quote) return;
      if (e.pointerType !== "mouse") return;

      const quoteid = quote.dataset.quoteid;

      let quoted

      if (Number(quoteid) == quoteid) {
        quoted = document.getElementById(Number(quoteid))
      } else {
        quoted = document.getElementById('OP')

      }
      if (isVisible(quoted)) {
        quoted.querySelector(".backpanel").style.backgroundColor = 'var(--panel)'
        quoted.querySelector(".post-header").style.backgroundImage = 'linear-gradient(var(--panel), var(--gradient))'
      } else {
        let quoteposts = document.getElementById(quoteid + 'hover')
        if (quoteposts) {
          quoteposts.remove()

        }
      }


    })

    const posts = document.querySelectorAll('.post')

    function hidePost(event, id) {
      if (event.target.closest('a')) {
    return
  }
      if (id == 'OP') {
             const post = document.querySelector(`#OP`)
              if (!post) {
                return
              }
            const panel = post.querySelector('.backpanel')
            if (!panel) {
                return
              }
            panel.classList.toggle('hidden')
      } else {
            const post = document.getElementById(String(id))
              if (!post) {
                return
              }
            const panel = post.querySelector('.backpanel')
            if (!panel) {
                return
              }
            panel.classList.toggle('hidden')
      }
      
    }
    const report = document.querySelector('.report_a')
    const report_modal = document.getElementById('report-box')
    const reportform = document.querySelector('#modal-form-report')
   
    reportform.addEventListener('submit', async e => {
      e.preventDefault()
       const rule = document.querySelector('#rule-select').value
       let threadid
       let postid
       if (report_modal.dataset.threadId && !report_modal.dataset.postId) {
        threadid = report_modal.dataset.threadId.trim()
         postid = null
       } else if ((!report_modal.dataset.threadId && report_modal.dataset.postId)) {
         threadid = null
         postid = report_modal.dataset.postId.trim()
       }
      
      if (!rule) {
        return
      }
      const response = await fetch('/api/report', {
        method: 'POST',

        headers: {
          'Content-Type': 'application/json'
        },

        body: JSON.stringify({
          thread_id: threadid,
          post_id: postid,
          rule: rule
        })
      })
      if (!response.ok) {
        alert('failed to report')
        return
      }
        document.querySelector('#report-box').close()
      return
    })

    document.addEventListener('click', async e => {
      const quote = e.target.closest('.quote');
      const report_button = e.target.closest('.report_a');
      const slap = e.target.closest('.slap');
      const shoot = e.target.closest('.shoot');
      const hide = e.target.closest('.hide');
      <% if (user.is_owner || user.is_admin || user.is_mod) { %>
         const deleter = e.target.closest('.delete');
          const ban = e.target.closest('.ban');
          const info = e.target.closest('.info');
     <% } %>
     
      const backpanels = document.querySelectorAll('.backpanel')
      const header = e.target.closest('.post-header')
      const reply = e.target.closest('.reply-button')
      // SLAP

      if (slap) {
        e.preventDefault();

        const slapid = slap.dataset.postid;

        if (slapid) {
          try {
            const response = await fetch('/api/slap', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                post_id: slapid,
                action: 'slap'
              })
            });

            const data = await response.json();

            if (!response.ok) {
              alert(data.error || 'Failed to slap post');
              return;
            }

            const postiq = document.querySelector(
              `[data-alarm="${slapid}"]`
            );

            if (postiq) {
              postiq.innerHTML =
                '<hr style="margin-bottom: 3px;border-color: 1px solid var(--border-color); color: var(--border-color); background-color: var(--border-color)">*SMACK*';

              postiq.classList.remove('hidden');
            }
          } catch (error) {
            console.error('Slap error:', error);
            alert('Failed to slap post');
          }
        }

        return;
      }


      // SHOOT

      if (shoot) {
        console.log('boom')
        e.preventDefault();

        const shootid = shoot.dataset.postid;

        if (shootid) {
          try {
            const response = await fetch('/api/shoot', {
              method: 'POST',
