        })
      })
      // idk i stole it 
      function makeElementMovable(element) {
        let pos1 = 0,
          pos2 = 0,
          pos3 = 0,
          pos4 = 0
        const header = document.getElementById(element.id + 'Header')
        if (header) {
          header.onmousedown = dragMouseDown
        } else {
          element.onmousedown = dragMouseDown
        }

        function dragMouseDown(e) {
          e = e || window.event
          e.preventDefault()
          pos3 = e.clientX
          pos4 = e.clientY
          document.onmousemove = elementDrag
          document.onmouseup = closeDragElement
        }

        function elementDrag(e) {
          e = e || window.event
          e.preventDefault()
          pos1 = pos3 - e.clientX
          pos2 = pos4 - e.clientY
          pos3 = e.clientX
          pos4 = e.clientY
          element.style.top = element.offsetTop - pos2 + 'px'
          element.style.left = element.offsetLeft - pos1 + 'px'
        }

        function closeDragElement() {
          document.onmousemove = null
          document.onmouseup = null
        }
      }

      const replyForm = document.getElementById('reply-form')
      const reply_textarea = document.getElementById('reply-textarea')

      replyForm.addEventListener('submit', async event => {
        event.preventDefault()
        const text = reply_textarea.value

        if (!text.trim()) return

        try {
          const response = await fetch('/api/create/post', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              text: text.trimEnd(),
              moshpit: '<%= thread.moshpit %>',
              thread_id: '<%= thread.id %>',
              html: formatText(text).trimEnd()
            })
          })

          if (!response.ok) {
            console.error('Failed to create post')
            return
          }

          reply_textarea.value = ''
          popup.classList.add('hidden')
          await getNewPosts()
        } catch (error) {
          alert('Failed to create post: ' + error)
        } 
      })
async function getNewPosts() {
      try {
        const after = getLastPostId()
       
        if (after === null) {
          return
        }

        const response = await fetch(
          `/api/refresh/<%= thread.id %>/${encodeURIComponent(after)}`,
          {
            method: 'GET',
            headers: {
              'Accept': 'application/json'
            },
            cache: 'no-store'
          }
        )

        if (!response.ok) {
          throw new Error(
            `Failed to get new posts: ${response.status} ${response.statusText}`
          )
        }

        const data = await response.json()

        const posts = Array.isArray(data)
          ? data
          : Array.isArray(data.posts)
            ? data.posts
            : []

        for (const post of posts) {
          if (!post || post.post_number === undefined) {
            continue
          }

          if (postAlreadyExists(post.post_number)) {
            continue
          }

          addPost(post)
          
        }
      } catch (error) {
        console.error('Error getting new posts:', error)
      }
    }
      function getLastPostId() {
      const postElements = document.querySelectorAll('.post[id]')

      if (!postElements.length) {
        return null
      }

      const lastPost = postElements[postElements.length - 1]

      return lastPost.id
    }
    function postAlreadyExists(postId) {
      if (postId === null || postId === undefined) {
        return false
      }

      return document.getElementById(String(postId)) !== null
    }

      function addPost(post) {
        const postElements = document.querySelectorAll('.post')
        const template = postElements[0]

       

        const newPost = template.cloneNode(true)
        const header = newPost.querySelector('.post-header')
        const headerInfo = header.querySelector('div > div')

        if (headerInfo) {
          const firstP = headerInfo.querySelector('p')
          if (firstP) {
            firstP.innerHTML = `${post.post_number} |&nbsp`
          }
        }

        const postbody = newPost.querySelector('.post-body')
        if (postbody) {
          postbody.innerHTML = formatText(post.comment)
   
        }

        const date = newPost.querySelector('[itemprop]')
        if (date) {
          date.dataset.time = post.created_at
     
        }

        const replyButton = newPost.querySelector('.reply-button')
        if (replyButton) {
          replyButton.dataset.threadId = post.post_number
          replyButton.addEventListener('click', event => {
            event.preventDefault()
            areatext.value += `@${post.post_number}\n`
            popup.classList.remove('hidden')
            areatext.focus()
          })
        }

        const threadContainer = document.getElementById('post-container')
        newPost.id = post.post_number
        threadContainer.appendChild(newPost)
        clearInterval(timerid)
          timerid = null
          timers = document.querySelectorAll('.timer')
          timers.forEach((t) => {
          
        t.textContent= dayjs.unix(Number(t.dataset.time)).fromNow() 
        })
        timerup()
      }

   
      function formatText(post) {
        let comment = ''
        if (!post) {
          return '' 
        } else if (!post.comment) {
          comment = post
        } else {
          comment = post.comment
        }
        const escaper = /(\s*)[<](\s*)/g
        comment = comment.replaceAll(escaper, `$1&lt;$2`)
        
       comment = partytext(comment)
        const regex = /@([0-9\s+]+|[OP\s+]+)/g
          
        return comment.replace(
          regex,
          `<a href="#$1" style="color: var(--rage)">@$1</a>`
        )
      }

      function partytext(c) {
        const spoiler = /\[\[\[([\s\S]*?)]]]/g
        let comment = c.replace(spoiler, `<s>$1</s>`)
        const array1 = comment.split("\n")
   
        let comment1 = ''
        const shake1 = /\[s1\]([\s\S]*?)\[\/s1\]/g
        const shake2 = /\[s2\]([\s\S]*?)\[\/s2\]/g
        const shake3 = /\[s3\]([\s\S]*?)\[\/s3\]/g
        const shake3a = /\[s3a\]([\s\S]*?)\[\/s3a\]/g
        const hori1 = /\[h1\]([\s\S]*?)\[\/h1\]/g
        const hori2 = /\[h2\]([\s\S]*?)\[\/h2\]/g
        const hori3 = /\[h3\]([\s\S]*?)\[\/h3\]/g
        const hori3a = /\[h3a\]([\s\S]*?)\[\/h3a\]/g
        const gay = /\[r\]([\s\S]*?)\[\/r\]/g
        const trans = /\[t\]([\s\S]*?)\[\/t\]/g
        const schizo = /\[tv\]([\s\S]*?)\[\/tv\]/g
        const schizoa = /\[tva\]([\s\S]*?)\[\/tva\]/g
        const yay = /\[v\]([\s\S]*?)\[\/v\]/g
        const yaya = /\[va\]([\s\S]*?)\[\/va\]/g
        const police = /\[p\]([\s\S]*?)\[\/p\]/g
        const bold = /\[b\]([\s\S]*?)\[\/b\]/g
        const italic = /\[i\]([\s\S]*?)\[\/i\]/g
        const big = /\[big\]([\s\S]*?)\[\/big\]/g
        const rage = /\[red\]([\s\S]*?)\[\/red\]/g

        const glow = /\[g\]([\s\S]*?)\[\/g\]/g
        array1.forEach((c) => {
         
            let pre = ''
            let end = ''
            if (c.startsWith('>')&& !c.startsWith('> ')) {
               pre = '<span class="greentext">' + pre
              end = end + '</span>'
            } else if (c.toLowerCase().startsWith("im gay") || c.toLowerCase().startsWith("i'm gay")) {
             pre = '<span class="gay">' + pre
              end = end + '</span>'
            } else if (c.toLowerCase().startsWith("im trans") || c.toLowerCase().startsWith("i'm trans")) {
             pre = '<span class="trans">' + pre
              end = end + '</span>'
            } else if (c.startsWith("THE VOICES")) {
             pre = '<span class="schizo">' + pre
              end = end + '</span>'
            }else if (c.toLowerCase().startsWith("yay")) {
             pre = '<span class="vert">' + pre
              end = end + '</span>'
            }else if (c.startsWith("POLICE")) {
             pre = '<span class="police">' + pre
              end = end + '</span>'
            }else if (c.startsWith("FUCK") || c.startsWith("WTF")) {
             pre = '<span class="rage">' + pre
              end = end + '</span>'
            }
          if (c.endsWith('!!!!!')) {
          //  comment1 = comment1 + '<span class="shake3">' + c + '</span>' + "\n"
           pre = '<span class="shake3">' + pre
          end = end + '</span>'
          
        } else if (c.endsWith('!!!!')) {
           pre = '<span class="shake2">' + pre
          end = end + '</span>'
          } else if (c.endsWith('!!!')) {
           pre = '<span class="shake1">' + pre
          end = end + '</span>'
        } else if (c.endsWith('....!')) {
           pre = '<span class="hori3">' + pre
          end = end + '</span>'
          } else if (c.endsWith('...!')) {
           pre = '<span class="hori2">' + pre
          end = end + '</span>'
        } else if (c.endsWith('..!')) {
           pre = '<span class="hori1">' + pre
          end = end + '</span>' } 
          else if (c.endsWith('?!?!?') || c.endsWith('!?!?!')) {
           pre = '<span class="shake3">' + pre
          end = end + '</span>'
          
        } else if (c.endsWith('?!?!') || c.endsWith('!?!?')) {
           pre = '<span class="shake2">' + pre
          end = end + '</span>'
          } else if (c.endsWith('?!?') || c.endsWith('!?!')) {
           pre = '<span class="shake1">' + pre
          end = end + '</span>'
        }else if (c.endsWith('.....')) {
           pre = '<span class="italic3">' + pre
          end = end + '</span>'
          } else if (c.endsWith('....')) {
           pre = '<span class="italic2">' + pre
          end = end + '</span>'
        } else if (c.endsWith('...')) {
           pre = '<span class="italic1">' + pre
          end = end + '</span>' } 
          
          else if(c === ''){
          
        } else {
          
           
           
        }
        comment1 = comment1 + pre + c + end + "\n"
        comment1 = comment1.replace(shake3a, '<span class="shake3a">$1</span>')
        comment1 = comment1.replace(shake3, '<span class="shake3">$1</span>')
        comment1 = comment1.replace(shake2, '<span class="shake2">$1</span>')
        comment1 = comment1.replace(shake1, '<span class="shake1">$1</span>')

        comment1 = comment1.replace(hori3a, '<span class="hori3a">$1</span>')
        comment1 = comment1.replace(hori3, '<span class="hori3">$1</span>')
        comment1 = comment1.replace(hori2, '<span class="hori2">$1</span>')
        comment1 = comment1.replace(hori1, '<span class="hori1">$1</span>')
        
        comment1 = comment1.replace(glow, '<span class="glow">$1</span>')
        comment1 = comment1.replace(gay, '<span class="gay">$1</span>')
        comment1 = comment1.replace(trans, '<span class="trans">$1</span>')
        comment1 = comment1.replace(schizo, '<span class="schizo">$1</span>')
        comment1 = comment1.replace(schizoa, '<span class="schizoa">$1</span>')
        comment1 = comment1.replace(yay, '<span class="vert">$1</span>')
        comment1 = comment1.replace(yaya, '<span class="verta">$1</span>')
        comment1 = comment1.replace(police, '<span class="police">$1</span>')
        comment1 = comment1.replace(rage, '<span class="rage">$1</span>')
        comment1 = comment1.replace(big, '<span class="big">$1</span>')
        comment1 = comment1.replace(bold, '<span class="bold">$1</span>')
        comment1 = comment1.replace(italic, '<span class="italic">$1</span>')


    
        })
        
        return comment1
      }
      
    </script>
