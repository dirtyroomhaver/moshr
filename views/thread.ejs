    function isVisible(el) {
      const rect = el.getBoundingClientRect()
      const xaxis = rect.x >= 0 && rect.right <= window.innerWidth
      const yaxis = rect.top >= 0 && rect.bottom <= window.innerHeight
      return xaxis && yaxis
    }

