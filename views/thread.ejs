<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>thread - moshr</title>
    <link rel="stylesheet" href="/../stylesheet.css" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <% 
    // Declare formatText at top level so EJS template blocks can use it safely
    function formatText(post) {
      if (!post || !post.comment) return '';
      const regex = /@([a-zA-Z0-9]+)/g;
      return post.comment.replace(regex, `<a href="#$1" style="color: var(--rage)">@$1</a>`);
    } 
    %>

    <div class="navbar" id="navbar">
      <div class="navbar-left">
        <ul class="nav-list">
          <li><a href="/">home</a></li>
          <li>|</li>
          <li><a href="/rules">rules</a></li>
          <li>|</li>
          <li><a href="/faq">faq</a></li>
          <li>|</li>
          <li><a href="/quirks">quirks</a></li>
          <li>|</li>
          <li><a href="/moshpits">moshpits</a></li>
        </ul>
      </div>
      <div class="navbar-middle">
        <div class="title">
          <h2 onclick="window.location.href='/<%= thread.moshpit %>/'">[ <%= thread.moshpit %> ]</h2>
        </div>
      </div>
      <div class="navbar-right">
        <a href="" id="create-thread">create new thread</a>
      </div>
    </div>

    <div class="announcement">
      <p id="announcement-text">afsafasfaf</p>
    </div>

    <div class="body-thread">
       <div class="thread-options" id="header">
          <div class="options-div">
            <a href="/<%= thread.moshpit %>/">return&nbsp</a>|
            <a href="#footer">bottom&nbsp</a>|
            <a href="" class="reply-button" data-thread-id="">reply</a>
          </div>
        </div>
      <div id="post-container"> 
       

        <!-- OP Post -->
        <div class="post" id="OP">
          <div class="post-header">
            <div style="display: flex; justify-content: space-between">
              <div style="display: flex">
                <% if(posts) { %>
                  <p>@OP |&nbsp</p> 
                <% } %>
                <p>anonymous (Italy) |&nbsp</p>
                <p itemprop="">9/13/25 17:00:00</p>
              </div>
              <div style="display: flex">
                <a href="" class="reply-button" data-thread-id="OP">reply</a>&nbsp|&nbsp
                <a href="" id="report_a">report</a>
              </div>
            </div>
          </div>
          <div
            style="
              min-height: 80px;
              background-color: var(--panel);
              display: flex;
              justify-content: space-between;
              flex-direction: column;
              padding: 7px;
            "
          >
            <div class="post-body"><p><%= thread.thread_text %></p></div>
            <div class="hidden">
              <p style="color: var(--rage); font-weight: bold">
                HAVE THE TIME WHEN YOU HOVER - USER WAS SHOT FOR THIS POST
              </p>
            </div>
          
            <div class="hidden"
              style="
                background-image: linear-gradient(var(--panel), var(--gradient));
                border-top: 1px solid var(--border-color);
              "
            >
              <ul class="post-replies"></ul>
            </div>
          </div>
        </div>

        <!-- Reply Posts Loop -->
        <% if (posts) {
          posts.forEach(post => { %>
            <div class="post" id="<%= post.post_number %>">
              <div class="post-header">
                <div style="display: flex; justify-content: space-between">
                  <div style="display: flex">
                    <p><%= post.post_number %> |&nbsp</p>
                    <p>anonymous (Italy) |&nbsp</p>
                    <p itemprop=""><%= new Date(post.created_at * 1000).toLocaleString('en-US', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric',
                      hour: 'numeric',
                      minute: '2-digit'
                    }) %></p>
                  </div>
                  <div style="display: flex">
                    <a href="" class="reply-button" data-thread-id="<%= post.post_number %>">reply</a>&nbsp|&nbsp
                    <a href="" class="report_a">report</a>
                  </div>
                </div>
              </div>
              
              <!-- Cleaned opening div wrapper -->
              <div
                style="
                  min-height: 80px;
                  background-color: var(--panel);
                  display: flex;
                  justify-content: space-between;
                  flex-direction: column;
                  padding: 7px;
                "
              >
                <div class="post-body"><p><%- formatText(post) %></p></div>
                <div class="hidden">
                  <p style="color: var(--rage); font-weight: bold">
                    HAVE THE TIME WHEN YOU HOVER - USER WAS SHOT FOR THIS POST
                  </p>
                </div>
              
                <div class="hidden"
                  style="
                    background-image: linear-gradient(var(--panel), var(--gradient));
                    border-top: 1px solid var(--border-color);
                  "
                >
                  <ul class="post-replies"></ul>
                </div>
              </div> <!-- Closed inner content div -->
            </div> <!-- Closed outer .post container div -->
        <% })} %>

      </div> <!-- /#post-container -->
      
      <div class="thread-options" id="footer">
        <div class="options-div">
          <a href="/<%= thread.moshpit %>/">return&nbsp</a>|
          <a href="#navbar">top&nbsp</a>|
          <a href="" class="reply-button" data-thread-id="">reply</a>
        </div>
      </div>
      <div class="anchor"></div>
    </div>
    
    <dialog id="create-thread-box">
      <div class="modal-top">
        <div><p>new thread</p></div>
        <div><button id="close-button">x</button></div>
      </div>
      <form id="modal-form">
        <hr />
        <div>
          <div class="modal-input">
            <label for="">comment</label
            ><textarea
              name="text"
              id="thread-text"
              style="height: 400px; width: 96.4%"
            ></textarea>
          </div>

          <div class="modal-input">
            <label for="">moshpit (board)</label
            ><input
              type="text"
              name="moshpit"
              placeholder="if left blank your thread will go onto the homepage"
            />
          </div>

          <div class="modal-input">
            <label for="">signature</label
            ><input
              type="text"
              placeholder="put a secure password here to sign your post"
            />
          </div>
          <div><button type="submit" id="button-thread">submit</button></div>
          <input type="hidden" name="post-text" id="post-text" />
        </div>
      </form>
    </dialog>

    <dialog id="report-box">
      <div class="modal-top">
        <div><p>report</p></div>
        <div><button id="close-button-2">x</button></div>
      </div>
      <hr />
      <form id="modal-form-report">
        <div>
          <label for="rule-select">what rule was violated?</label>
          <select name="reported_rule" id="rule-select">
            <option value="" selected disabled hidden>
              --please choose an option--
            </option>
            <option value="1">1. dont post anything that violates local or US law</option>
            <option value="2">2. dont post here if you are under 18</option>
            <option value="3">3. dont spam</option>
            <option value="4">4. dont advertise anything you get monetary gain from</option>
            <option value="5">5. dont post offtopic threads or replies</option>
            <option value="6">6. dont dox or raid</option>
            <option value="7">7. dont send false reports</option>
            <option value="8">8. dont link to nsfw content</option>
            <option value="9">9. dont joke about child abuse</option>
            <option value="10">10. dont be obnoxiously racist, homophobic, or transphobic</option>
          </select>
          <label>false reports = ban</label>
          <button type="submit">submit</button>
        </div>
      </form>
    </dialog>

    <div id="myPopup" class="popup hidden">
      <div id="myPopupHeader" class="popup-header">
        <p>reply</p>
        <button id="close-button3">x</button>
      </div>
      <div style="background-color: var(--panel); padding: 3px">
        <form action="" id="reply-form">
          <textarea name="reply" id="reply-textarea"></textarea>
          <div>
            <div>
              <label for="reply-sig" style="margin: 0px 0px 0px -5px">signature</label>
              <input
                id="reply-sig"
                type="text"
                placeholder="put a secure password here to sign your post"
                style="width: 100%"
              />
            </div>
            <div style="display: flex; justify-content: right; margin-top: 5px">
              <button id="submit-reply" type="submit">submit</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <script>
      const createThread = document.getElementById('create-thread')
      const modal = document.getElementById('create-thread-box')

      createThread.addEventListener('click', (event) => {
        event.preventDefault()
        modal.showModal()
      })
      const createThreadForm = document.getElementById('modal-form')
      const buttonThreadForm = document.getElementById('button-thread')
      const textarea = document.getElementById('thread-text')
      
      createThreadForm.addEventListener('submit', async event => {
        // Prevent the browser from reloading the page
        event.preventDefault()
        const text = textarea.value
        const moshpit = document.querySelector('input[name="moshpit"]').value
        if (!text.trim()) {
          return
        }

        const response = await fetch('/api/create/thread', {
          method: 'POST',

          headers: {
            'Content-Type': 'application/json'
          },

          body: JSON.stringify({
            text: text,
            moshpit: moshpit
          })
        })

        if (!response.ok) {
          console.error('Failed to create thread')
          return
        }

        const data = await response.json()
        window.location.href = `/${data.moshpit.title}/${data.threadId}`
      })


      const report = document.getElementById('report_a')
      const report_modal = document.getElementById('report-box')

      if (report) {
        report.addEventListener('click', (event) => {
          event.preventDefault()
          report_modal.showModal()
        })
      }

      const closeButton = document.getElementById('close-button')
      closeButton.addEventListener('click', (event) => {
        event.preventDefault()
        modal.close()
      })

      const closeButton2 = document.getElementById('close-button-2')
      closeButton2.addEventListener('click', (event) => {
        event.preventDefault()
        report_modal.close()
      })

      const popup = document.getElementById('myPopup')
      const areatext = document.getElementById('reply-textarea')
      const closeButton3 = document.getElementById('close-button3')

      closeButton3.addEventListener('click', (event) => {
        event.preventDefault()
        areatext.value = ''
        areatext.style.width = ''
        areatext.style.height = ''
        popup.classList.add('hidden')
      })

      makeElementMovable(document.getElementById('myPopup'))

      document.querySelectorAll('.reply-button').forEach(a => {
        a.addEventListener('click', (event) => {
          event.preventDefault()
          areatext.value += a.dataset.threadId ? '@' + a.dataset.threadId + '\n' : ''
          popup.classList.remove('hidden')
          areatext.focus()
        })
      })

      function makeElementMovable(element) {
        let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0
        const header = document.getElementById(element.id + 'Header')
        if (header) {
          header.onmousedown = dragMouseDown
        } else {
          element.onmousedown = dragMouseDown
        }

        function dragMouseDown(e) {
          e = e || window.event
          e.preventDefault()
          pos3 = e.clientX
          pos4 = e.clientY
          document.onmousemove = elementDrag
          document.onmouseup = closeDragElement
        }

        function elementDrag(e) {
          e = e || window.event
          e.preventDefault()
          pos1 = pos3 - e.clientX
          pos2 = pos4 - e.clientY
          pos3 = e.clientX
          pos4 = e.clientY
          element.style.top = (element.offsetTop - pos2) + 'px'
          element.style.left = (element.offsetLeft - pos1) + 'px'
        }

        function closeDragElement() {
          document.onmousemove = null
          document.onmouseup = null
        }
      }

      const replyForm = document.getElementById('reply-form')
      const reply_textarea = document.getElementById('reply-textarea')

      replyForm.addEventListener('submit', async event => {
        event.preventDefault()
        const text = reply_textarea.value

        if (!text.trim()) return

        try {
          const response = await fetch('/api/create/post', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              text: text,
              moshpit: '<%= thread.moshpit %>',
              thread_id: '<%= thread.id %>'
            })
          })

          if (!response.ok) {
            console.error('Failed to create post')
            return
          }

          reply_textarea.value = ''
          popup.classList.add('hidden')
        } catch (error) {
          alert('Failed to create post: ' + error)
        }
      })

      const events = new EventSource(`/api/events?thread_id=<%= thread.id %>`)


      events.onmessage = (event) => {
  console.log(JSON.parse(event.data));
};

// Close connection cleanly when changing pages or reloading
window.addEventListener('beforeunload', () => {
  events.close();
});
      events.addEventListener('new-post', event => {
        const post = JSON.parse(event.data)
        addPost(post)
      })

      events.onerror = error => {
        console.error('SSE error:', error)
      }

      function addPost(post) {
        const postElements = document.querySelectorAll('.post')
        const template = postElements[0]

        if (!template) {
          console.error('No .post exists to use as a template')
          return
        }

        const newPost = template.cloneNode(true)
        const header = newPost.querySelector('.post-header')
        const headerInfo = header.querySelector('div > div')

        if (headerInfo) {
          const firstP = headerInfo.querySelector('p')
          if (firstP) {
            firstP.textContent = `${post.post_number} | `
          }
        }

        const postbody = newPost.querySelector('.post-body')
        if (postbody) {
          postbody.innerHTML = formatText(post)
        }

        const date = newPost.querySelector('[itemprop]')
        if (date) {
          date.textContent = new Date(post.created_at).toLocaleString()
        }

        const replyButton = newPost.querySelector('.reply-button')
        if (replyButton) {
          replyButton.dataset.threadId = post.post_number
          replyButton.addEventListener('click', event => {
            event.preventDefault()
            areatext.value += `@${post.post_number}\n`
            popup.classList.remove('hidden')
            areatext.focus()
          })
        }

        const threadContainer = document.getElementById('post-container')
        newPost.id = post.post_number
        threadContainer.appendChild(newPost)
      }

      // Client-side helper function for dynamic SSE posts
      function formatText(post) {
        if (!post || !post.comment) return ''
        const regex = /@([a-zA-Z0-9]+)/g
        return post.comment.replace(regex, `<a href="#$1" style="color: var(--rage)">@$1</a>`)
      }
    </script>
  </body>
</html>