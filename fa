 reportform.addEventListener('submit', (e) => {
      e.preventDefault()
       const rule = document.querySelector('#rule-select').value
       let threadid
       let postid
       if (report_modal.dataset.threadId && !report_modal.dataset.postId) {
        threadid = report_modal.dataset.threadId
         postid = ''
       } else if ((!report_modal.dataset.threadId && report_modal.dataset.postId)) {
         threadid = ''
         postid = report_modal.dataset.postId
       }
      
      if (!rule) {
        return
      }
      const response = await fetch('/api/report', {
        method: 'POST',

        headers: {
          'Content-Type': 'application/json'
        },

        body: JSON.stringify({
          thread_id: threadid.trim(),
          post_id: postid.trim(),
          rule: rule
        })
      })
      if (!response.ok) {
        alert('failed to report')
        return
      }

      return
    })
